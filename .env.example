# ─────────────────────────────────────────────────────────────────────────────
# Football-IQ — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
#
# Local development quick start:
#   cp .env.example .env
#   docker-compose up -d db
#   docker-compose --profile migrate up migrate
#   docker-compose up backend frontend
#
# See docs/runbook-local.md for a full per-service breakdown.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=changeme-at-least-32-chars-long
LOG_LEVEL=INFO

# ── Database (Postgres) ───────────────────────────────────────────────────────
# Local dev (Docker Compose): use the values below as-is.
# Cloud (Neon / Supabase / Railway / RDS): replace with your connection string.
DATABASE_URL=postgresql+asyncpg://footiq:footiq_dev@localhost:5432/footiq
# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql://footiq:footiq_dev@localhost:5432/footiq

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare R2 — object storage
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_RAW=raw-video
R2_BUCKET_CLIPS=clips
R2_BUCKET_OVERLAYS=overlays
R2_BUCKET_ARTIFACTS=artifacts
# Presigned URL expiry in seconds (default: 3600 = 1 hour)
R2_PRESIGN_TTL=3600

# Cloudflare Queues
CF_QUEUE_VIDEO_PROCESSING=video-processing-jobs
CF_QUEUE_NIGHTLY_TRAINING=nightly-training-exports

# Cloudflare Workers
# Worker name: football-iq
# Worker bindings: RAW_VIDEO, CLIPS, OVERLAYS, ARTIFACTS, VIDEO_PROCESSING_JOBS
WORKER_URL=https://football-iq.firas-azfar.workers.dev

# ── Frontend (public — safe to expose to browser) ────────────────────────────
# Local dev: use localhost. Production: replace with Fly.io / Worker URLs.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# JWT algorithm: HS256 | RS256
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token lifetime in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── University SSO (optional) ─────────────────────────────────────────────────
# Set if university SSO / SAML / OAuth2 provider is available
SSO_PROVIDER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# ── Fly.io (backend hosting) ──────────────────────────────────────────────────
FLY_API_TOKEN=your-fly-io-api-token
FLY_APP_NAME=football-iq-backend

# ── GPU Worker ────────────────────────────────────────────────────────────────
# Queue polling interval in seconds
GPU_WORKER_POLL_INTERVAL=10
# R2 creds are reused from R2_* vars above
# Optional: burst GPU provider (RunPod / Modal / Lambda Labs)
RUNPOD_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Capture-regime detector (Issue #126) ──────────────────────────────────────
# Minimum fusion confidence required to classify a clip as drone_follow or
# fixed_sideline. Below this threshold the detector falls back to "unknown".
REGIME_MIN_CONFIDENCE=0.55
# Optional uncertainty band around the decision boundary. Predictions within
# ±margin of 0.5 are labeled "unknown" instead of forcing a regime class.
REGIME_MARGIN=0.05
# Optional path to a joblib-serialized logistic-regression coefficient dict.
# When absent (the default), the detector uses a hand-tuned linear fallback so
# the pipeline works in dev/CI without a trained artifact.
REGIME_MODEL_PATH=

# ── College Football Data (CFBD) — backend-only (Issues #160/#161/#162) ───────
# Vendor API for Toledo / MAC college-football analytics. BACKEND-ONLY:
# the FastAPI service is the only runtime that calls CFBD. NEVER expose this
# key to the frontend, browser bundles, logs, PR/issue text, R2 artifacts, or
# coach-visible errors, and never store it in the database. Request a free key
# at https://collegefootballdata.com/key and set it locally in .env only.
# See docs/runbook-local.md for the secret-setup steps (no values committed).
CFBD_API_KEY=
CFBD_BASE_URL=https://api.collegefootballdata.com

# ── Observability ─────────────────────────────────────────────────────────────
# Port for GPU worker Prometheus metrics HTTP server
GPU_METRICS_PORT=9090

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://football-iq.pages.dev

# ── CollegeFootballData (CFBD) — Issues #161/#162/#163 ────────────────────────
# American football (college) data only. BACKEND-ONLY: the key is read by the
# FastAPI backend / ingestion. NEVER expose it to the frontend, browser bundles,
# Workers, logs, or coach-visible errors. The read-only analytics API
# (/api/cfbd/*) serves cached Postgres rows and does not use the key.
CFBD_API_KEY=
CFBD_BASE_URL=https://api.collegefootballdata.com
# Cached CFBD rows older than this are flagged ``stale`` to the UI (hours).
CFBD_CACHE_STALE_AFTER_HOURS=168

# ── Governance: health/workload gating (Issue #113) ───────────────────────────
# Number of queued processing_jobs at-or-above which heavy endpoints (jobs
# create/retry, GPU-bound triggers) are gated with HTTP 503 workload_gated.
WORKLOAD_QUEUE_THRESHOLD=50
# Number of concurrently running processing_jobs that triggers saturation.
WORKLOAD_RUNNING_THRESHOLD=20
# Set to "true" to bypass gating entirely (incident workarounds only —
# audit logs continue to flow either way).
WORKLOAD_GATING_DISABLED=false
