    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^7.0.2",
